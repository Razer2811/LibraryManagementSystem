@model Location
@{ ViewData["Title"] = "Xóa vị trí"; }

<div class="app-content-header">
    <div class="container-fluid">
        <ol class="breadcrumb float-sm-end mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Vị trí</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xóa vị trí</li>
        </ol>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="col-xl-8 col-lg-10">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Xác nhận xóa vị trí</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">Bạn có chắc chắn muốn xóa vị trí này không?</div>
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Mã vị trí</dt>
                        <dd class="col-sm-9">@Model.LocationCode</dd>
                        <dt class="col-sm-3">Tên vị trí</dt>
                        <dd class="col-sm-9 fw-medium">@Model.LocationName</dd>
                        <dt class="col-sm-3">Tầng / phòng / kệ</dt>
                        <dd class="col-sm-9">@(Model.Floor ?? "—") / @(Model.Room ?? "—") / @(Model.Shelf ?? "—")</dd>
                    </dl>
                </div>
                <div class="card-footer d-flex flex-wrap gap-2">
                    <form asp-action="DeleteLocationConfirmed" asp-route-id="@Model.LocationId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Xác nhận xóa</button>
                    </form>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
                </div>
            </div>
        </div>
    </div>
</div>
