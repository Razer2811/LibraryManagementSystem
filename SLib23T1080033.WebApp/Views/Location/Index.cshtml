@model IEnumerable<SLib23T1080033.Models.Entities.Location>

@{
    ViewData["Title"] = "Quản lý vị trí";
}

<h2>Quản lý vị trí lưu trữ</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<p>
    <a asp-action="CreateLocation" class="btn btn-primary">
        Thêm vị trí
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã ID</th>
            <th>Mã vị trí</th>
            <th>Tên vị trí</th>
            <th>Tầng</th>
            <th>Phòng</th>
            <th>Kệ</th>
            <th>Mô tả</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LocationId</td>
                <td>@item.LocationCode</td>
                <td>@item.LocationName</td>
                <td>@item.Floor</td>
                <td>@item.Room</td>
                <td>@item.Shelf</td>
                <td>@item.Description</td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="text-success">Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="text-danger">Ngừng hoạt động</span>
                    }
                </td>
                <td>
                    <a asp-action="EditLocation"
                       asp-route-id="@item.LocationId"
                       class="btn btn-warning btn-sm">
                        Sửa
                    </a>

                    <a asp-action="DeleteLocation"
                       asp-route-id="@item.LocationId"
                       class="btn btn-danger btn-sm">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
