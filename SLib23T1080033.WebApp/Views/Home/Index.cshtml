@{
    ViewData["Title"] = "Tổng quan";
    ViewBag.Description = "Truy cập nhanh các khu vực quản lý dữ liệu và nghiệp vụ thư viện.";
}

<div class="app-content">
    <div class="container-fluid">
        <p class="text-secondary mb-3">@ViewBag.Description</p>
        <div class="row g-3">
            <div class="col-12 col-xl-6">
                <section class="card h-100">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="bi bi-folder2-open me-2"></i>Danh mục dữ liệu
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <a class="library-quick-link" asp-controller="Publisher" asp-action="Index">
                                    <i class="bi bi-building"></i>
                                    <span><strong>Nhà xuất bản</strong><small>Quản lý thông tin nhà xuất bản</small></span>
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a class="library-quick-link" asp-controller="Author" asp-action="Index">
                                    <i class="bi bi-person-badge"></i>
                                    <span><strong>Tác giả</strong><small>Quản lý hồ sơ tác giả</small></span>
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a class="library-quick-link" asp-controller="Category" asp-action="Index">
                                    <i class="bi bi-tags"></i>
                                    <span><strong>Phân loại sách</strong><small>Tổ chức sách theo danh mục</small></span>
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a class="library-quick-link" asp-controller="Language" asp-action="Index">
                                    <i class="bi bi-translate"></i>
                                    <span><strong>Ngôn ngữ</strong><small>Quản lý ngôn ngữ xuất bản</small></span>
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a class="library-quick-link" asp-controller="MemberType" asp-action="Index">
                                    <i class="bi bi-people"></i>
                                    <span><strong>Loại độc giả</strong><small>Thiết lập nhóm độc giả</small></span>
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a class="library-quick-link" asp-controller="Location" asp-action="Index">
                                    <i class="bi bi-archive"></i>
                                    <span><strong>Nơi lưu trữ</strong><small>Quản lý vị trí lưu sách</small></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <div class="col-12 col-xl-6">
                <section class="card h-100">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="bi bi-briefcase me-2"></i>Nghiệp vụ thư viện
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <a class="library-quick-link" asp-controller="Book" asp-action="Index">
                                    <i class="bi bi-book"></i>
                                    <span><strong>Sách</strong><small>Tra cứu và quản lý kho sách</small></span>
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a class="library-quick-link" asp-controller="Member" asp-action="Index">
                                    <i class="bi bi-person-lines-fill"></i>
                                    <span><strong>Độc giả</strong><small>Quản lý hồ sơ và thẻ độc giả</small></span>
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a class="library-quick-link" asp-controller="Employee" asp-action="Index">
                                    <i class="bi bi-person-workspace"></i>
                                    <span><strong>Nhân viên</strong><small>Thông tin nhân viên thư viện</small></span>
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a class="library-quick-link" asp-controller="Borrowing" asp-action="Index">
                                    <i class="bi bi-journal-arrow-up"></i>
                                    <span><strong>Mượn sách</strong><small>Theo dõi nghiệp vụ mượn</small></span>
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a class="library-quick-link" asp-controller="Return" asp-action="Index">
                                    <i class="bi bi-boxes"></i>
                                    <span><strong>Trả sách</strong><small>Theo dõi nghiệp vụ trả</small></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>
