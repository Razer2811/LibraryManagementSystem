@model SLib23T1080033.Models.DTOs.EmployeeDTO

@{
    ViewData["Title"] = "Thêm nhân viên";
    ViewBag.Description = "Nhập thông tin để tạo hồ sơ nhân viên mới.";
}

<div class="app-content">
    <div class="container-fluid">
        <p class="text-secondary mb-3">@ViewBag.Description</p>
        <div class="row justify-content-center">
            <div class="col-xl-8 col-lg-10">
                <form asp-action="CreateEmployee" method="post">
                    @Html.AntiForgeryToken()
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="bi bi-person-plus me-2"></i>Thông tin nhân viên</h3>
                        </div>
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="LastName" class="form-label">Họ</label>
                                    <input asp-for="LastName" class="form-control" maxlength="100"
                                           placeholder="Nhập họ" autofocus required />
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="FirstName" class="form-label">Tên</label>
                                    <input asp-for="FirstName" class="form-control" maxlength="50"
                                           placeholder="Nhập tên" required />
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="DateOfBirth" class="form-label">Ngày sinh</label>
                                    <input asp-for="DateOfBirth" type="date"
                                           max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
                                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Email" class="form-label">Email</label>
                                    <input asp-for="Email" type="email" class="form-control" maxlength="50"
                                           placeholder="name@example.com" required />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Phone" class="form-label">Số điện thoại</label>
                                    <input asp-for="Phone" type="tel" class="form-control" maxlength="50"
                                           placeholder="Nhập số điện thoại" />
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Address" class="form-label">Địa chỉ</label>
                                    <input asp-for="Address" class="form-control" maxlength="255"
                                           placeholder="Nhập địa chỉ" />
                                    <span asp-validation-for="Address" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="alert alert-light border mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                Nhân viên mới được tạo ở trạng thái đang làm việc. Mật khẩu không được quản lý tại màn hình này.
                            </div>
                        </div>
                        <div class="card-footer d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-dark">
                                <i class="bi bi-check-lg me-1"></i>Thêm nhân viên
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Quay lại
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
