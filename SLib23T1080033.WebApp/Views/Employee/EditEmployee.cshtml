@model SLib23T1080033.Models.DTOs.EmployeeDTO

@{
    ViewData["Title"] = "Sửa nhân viên";
    ViewBag.Description = "Cập nhật hồ sơ nhân viên; trạng thái làm việc được quản lý riêng.";
}

<div class="app-content">
    <div class="container-fluid">
        <p class="text-secondary mb-3">@ViewBag.Description</p>
        <div class="row justify-content-center">
            <div class="col-xl-8 col-lg-10">
                <form asp-action="EditEmployee" asp-route-id="@Model.EmployeeId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="EmployeeId" />
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="bi bi-person-gear me-2"></i>Thông tin nhân viên</h3>
                        </div>
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <div class="alert alert-light border d-flex flex-wrap gap-2 align-items-center">
                                <strong>Trạng thái:</strong>
                                @if (Model.IsWorking)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis">Đang làm việc</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">Đã ngừng làm việc</span>
                                }
                                <small class="text-secondary">Trạng thái chỉ thay đổi qua thao tác riêng.</small>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="LastName" class="form-label">Họ</label>
                                    <input asp-for="LastName" class="form-control" maxlength="100" required />
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="FirstName" class="form-label">Tên</label>
                                    <input asp-for="FirstName" class="form-control" maxlength="50" required />
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="DateOfBirth" class="form-label">Ngày sinh</label>
                                    <input asp-for="DateOfBirth" type="date"
                                           max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
                                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Email" class="form-label">Email</label>
                                    <input asp-for="Email" type="email" class="form-control" maxlength="50" required />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Phone" class="form-label">Số điện thoại</label>
                                    <input asp-for="Phone" type="tel" class="form-control" maxlength="50" />
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Address" class="form-label">Địa chỉ</label>
                                    <input asp-for="Address" class="form-control" maxlength="255" />
                                    <span asp-validation-for="Address" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-dark">
                                <i class="bi bi-check-lg me-1"></i>Lưu thay đổi
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Quay lại
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
