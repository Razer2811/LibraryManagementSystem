@{
    Layout = null;
}

<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập | SLib</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/adminlte/css/adminlte.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        /* Đổi tên để không bị trùng với .login-page của AdminLTE */
        .slib-login {
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .slib-login-card {
            width: 100%;
            max-width: 430px;
            margin: 0 auto;
        }

        .slib-brand-icon {
            width: 46px;
            height: 46px;
            flex-shrink: 0;
        }

        @@media (max-width: 575.98px) {
            .slib-login {
                padding: 1rem;
            }

            .slib-login-card .card-body {
                padding: 1.5rem !important;
            }
        }
    </style>
</head>
<body class="bg-body-tertiary">
    <main class="slib-login">
        <section class="card shadow-sm slib-login-card" aria-labelledby="login-title">
            <div class="card-header py-3">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <img src="~/favicon.ico" alt="Logo" class="brand-image opacity-75 shadow" />
                    <div>
                        <h1 class="h5 card-title mb-1">SLib</h1>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h2 id="login-title" class="h4 mb-1">Đăng nhập</h2>
                </div>

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="username" class="form-label">Tên đăng nhập hoặc email</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person" aria-hidden="true"></i>
                            </span>
                            <input id="username" name="username" type="text" class="form-control"
                                   autocomplete="username" placeholder="Nhập tên đăng nhập hoặc email"
                                   required autofocus />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock" aria-hidden="true"></i>
                            </span>
                            <input id="password" name="password" type="password" class="form-control"
                                   autocomplete="current-password" placeholder="Nhập mật khẩu" required />
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input id="rememberMe" name="rememberMe" type="checkbox" value="true"
                               class="form-check-input" />
                        <label for="rememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                    </div>

                    <button type="submit" class="btn btn-dark w-100">
                        <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>Đăng nhập
                    </button>
                </form>
            </div>
        </section>
    </main>
</body>
</html>