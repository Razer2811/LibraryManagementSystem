@model IEnumerable<SLib23T1080033.Models.Entities.MemberType>

@{
    ViewBag.Title = "Quản lý loại độc giả";
}


<div class="catalogue-index">
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<p>
    <span class="catalogue-search">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" class="form-control" data-table-search="#member-type-table"
               placeholder="Tìm loại độc giả..." aria-label="Tìm kiếm loại độc giả" />
    </span>
    <a asp-action="CreateMemberType" class="btn btn-primary">
        Thêm loại độc giả
    </a>
</p>

<table id="member-type-table" class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tên loại</th>
            <th>Số sách mượn tối đa</th>
            <th>Thời hạn mượn (ngày)</th>
            <th>Số lần gia hạn</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MemberTypeId</td>
                <td>@item.TypeName</td>
                <td>@item.MaxActiveLoans</td>
                <td>@item.LoanPeriodDays</td>
                <td>@item.MaxRenewals</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Đang hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Ngừng hoạt động</span>
                        }
                    </td>
               
                <td>
                    <a asp-action="EditMemberType"
                       asp-route-id="@item.MemberTypeId"
                       class="btn btn-warning btn-sm">
                        Sửa
                    </a>

                    <a asp-action="DeleteMemberType"
                       asp-route-id="@item.MemberTypeId"
                       class="btn btn-danger btn-sm">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
