@model MemberType
@{ ViewData["Title"] = "Thêm loại độc giả"; }
<div class="app-content"><div class="container-fluid"><div class="col-xl-8 col-lg-10"><form asp-action="CreateMemberType" method="post">@Html.AntiForgeryToken()<div class="card"><div class="card-body"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="TypeName" class="form-label">Tên loại độc giả</label><input asp-for="TypeName" class="form-control" /><span asp-validation-for="TypeName" class="text-danger"></span></div><div class="row"><div class="col-md-4 mb-3"><label asp-for="MaxActiveLoans" class="form-label">Số sách mượn tối đa</label><input asp-for="MaxActiveLoans" type="number" min="0" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="LoanPeriodDays" class="form-label">Thời hạn mượn</label><input asp-for="LoanPeriodDays" type="number" min="1" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="MaxRenewals" class="form-label">Số lần gia hạn</label><input asp-for="MaxRenewals" type="number" min="0" class="form-control" /></div></div><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Đang hoạt động</label></div></div><div class="card-footer d-flex gap-2"><button type="submit" class="btn btn-dark"><i class="bi bi-check-lg me-1"></i>Thêm loại độc giả</button><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div></div></form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
