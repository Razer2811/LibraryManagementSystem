@model MemberType

@{
    ViewData["Title"] = "Thêm loại độc giả";
}

<!-- Breadcrumb: một dòng, căn trái thẳng hàng với tiêu đề -->
<div class="app-content-header">
    <div class="container-fluid">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Loại độc giả</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thêm loại độc giả</li>
        </ol>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-xl-8 col-lg-10">

                <form asp-action="CreateMemberType" method="post">

                    <div class="card">
                        <div class="card-body">

                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="TypeName" class="form-label">Tên loại độc giả</label>
                                <input asp-for="TypeName" class="form-control"
                                       placeholder="Nhập tên loại độc giả" autofocus />
                                <span asp-validation-for="TypeName" class="text-danger small"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="MaxActiveLoans" class="form-label">Số sách mượn tối đa</label>
                                    <input asp-for="MaxActiveLoans" type="number" min="0" class="form-control" />
                                    <span asp-validation-for="MaxActiveLoans" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="LoanPeriodDays" class="form-label">Thời hạn mượn (ngày)</label>
                                    <input asp-for="LoanPeriodDays" type="number" min="1" class="form-control" />
                                    <span asp-validation-for="LoanPeriodDays" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="MaxRenewals" class="form-label">Số lần gia hạn</label>
                                    <input asp-for="MaxRenewals" type="number" min="0" class="form-control" />
                                    <span asp-validation-for="MaxRenewals" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="form-check mb-0">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label">Đang hoạt động</label>
                            </div>

                        </div>

                        <div class="card-footer d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-dark">
                                <i class="bi bi-check-lg me-1"></i>Thêm loại độc giả
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Quay lại
                            </a>
                        </div>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}