@model IEnumerable<SLib23T1080033.Models.Entities.Category>

@{
    ViewData["Title"] = "Quản lý danh mục";
    var categories = Model?.ToList()
        ?? new List<SLib23T1080033.Models.Entities.Category>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Quản lý danh mục</h2>

        <a asp-action="CreateCategory" class="btn btn-primary">
            + Thêm danh mục
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Mã danh mục</th>
                        <th>Tên danh mục</th>
                        <th>Mã danh mục cha</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (categories.Any())
                    {
                        foreach (var category in categories)
                        {
                            <tr>
                                <td>@category.CategoryId</td>
                                <td>@category.CategoryName</td>
                                <td>
                                    @if (category.ParentCategoryId.HasValue)
                                    {
                                        var parent = categories.FirstOrDefault(
                                        c => c.CategoryId ==
                                        category.ParentCategoryId.Value);

                                        @(parent?.CategoryName
                                                                    ?? category.ParentCategoryId.Value.ToString())
                                                        }
                                    else
                                    {
                                        <span>Danh mục gốc</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="EditCategory"
                                       asp-route-id="@category.CategoryId"
                                       class="btn btn-warning btn-sm">
                                        Sửa
                                    </a>

                                    <a asp-action="DeleteCategory"
                                       asp-route-id="@category.CategoryId"
                                       class="btn btn-danger btn-sm">
                                        Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">
                                Chưa có dữ liệu danh mục.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>