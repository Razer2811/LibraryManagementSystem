@model IEnumerable<Category>

@{
    ViewBag.Title = "Quản lý danh mục";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row align-items-center">
            
            <div class="col-sm-2">
                <ol class="breadcrumb float-sm-end mb-0">
                    <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Danh mục</li>
                </ol>
            </div>
        </div>
    </div>
</div>


<div class="app-content">
    <div class="container-fluid">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <form method="get" asp-action="Index" class="flex-grow-1" style="max-width: 420px;">
                        <div class="input-group">
                            <input type="search"
                                   name="keyword"
                                   value="@ViewBag.Keyword"
                                   class="form-control"
                                   placeholder="Tìm danh mục"
                                   aria-label="Từ khóa tìm kiếm" />
                            <button type="submit" class="btn btn-outline-secondary">
                                <i class="bi bi-search me-1"></i>Tìm
                            </button>
                        </div>
                    </form>

                    <a asp-action="CreateCategory" class="btn btn-dark">
                        <i class="bi bi-plus-lg me-1"></i>Thêm danh mục
                    </a>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Tên danh mục</th>
                                <th>Mô tả</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-medium">@item.CategoryName</td>
                                        <td>@(item.Description ?? "—")</td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success-emphasis">Hoạt động</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary-emphasis">Ngừng hoạt động</span>
                                            }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a asp-action="EditCategory"
                                               asp-route-id="@item.CategoryId"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="Sửa">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="DeleteCategory"
                                               asp-route-id="@item.CategoryId"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Xóa"
                                               onclick="return confirm('Bạn có chắc muốn xóa danh mục này không?');">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-secondary py-4">
                                        Chưa có dữ liệu danh mục.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
