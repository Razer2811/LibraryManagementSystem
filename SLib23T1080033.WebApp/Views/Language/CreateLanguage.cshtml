@model Language
@{ ViewData["Title"] = "Thêm ngôn ngữ"; }

<div class="app-content-header">
    <div class="container-fluid">
        <ol class="breadcrumb float-sm-end mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Ngôn ngữ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thêm ngôn ngữ</li>
        </ol>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="col-xl-8 col-lg-10">
            <form asp-action="CreateLanguage" method="post">
                @Html.AntiForgeryToken()
                <div class="card">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="LanguageCode" class="form-label">Mã ngôn ngữ</label>
                            <input asp-for="LanguageCode" class="form-control" placeholder="Ví dụ: vi" />
                            <span asp-validation-for="LanguageCode" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="LanguageName" class="form-label">Tên ngôn ngữ</label>
                            <input asp-for="LanguageName" class="form-control" placeholder="Nhập tên ngôn ngữ" />
                            <span asp-validation-for="LanguageName" class="text-danger"></span>
                        </div>
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">Đang hoạt động</label>
                        </div>
                    </div>
                    <div class="card-footer d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-dark"><i class="bi bi-check-lg me-1"></i>Thêm ngôn ngữ</button>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
