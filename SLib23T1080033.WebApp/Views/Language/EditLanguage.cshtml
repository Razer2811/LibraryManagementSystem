@model Language
@{ ViewData["Title"] = "Sửa ngôn ngữ"; }
<div class="app-content"><div class="container-fluid"><div class="col-xl-8 col-lg-10"><form asp-action="EditLanguage" asp-route-id="@Model.LanguageId" method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="LanguageId" /><div class="card"><div class="card-body"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="LanguageCode" class="form-label">Mã ngôn ngữ</label><input asp-for="LanguageCode" class="form-control" /><span asp-validation-for="LanguageCode" class="text-danger"></span></div><div class="mb-3"><label asp-for="LanguageName" class="form-label">Tên ngôn ngữ</label><input asp-for="LanguageName" class="form-control" /><span asp-validation-for="LanguageName" class="text-danger"></span></div><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Đang hoạt động</label></div></div><div class="card-footer d-flex gap-2"><button type="submit" class="btn btn-dark"><i class="bi bi-check-lg me-1"></i>Lưu thay đổi</button><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div></div></form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
