@model Language
@{ ViewData["Title"] = "Xóa ngôn ngữ"; }
<div class="app-content"><div class="container-fluid"><div class="col-xl-8 col-lg-10"><div class="card border-danger"><div class="card-header bg-danger text-white"><h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Xác nhận xóa ngôn ngữ</h5></div><div class="card-body"><div class="alert alert-warning">Bạn có chắc chắn muốn xóa ngôn ngữ này không?</div><dl class="row mb-0"><dt class="col-sm-3">Mã ngôn ngữ</dt><dd class="col-sm-9">@Model.LanguageCode</dd><dt class="col-sm-3">Tên ngôn ngữ</dt><dd class="col-sm-9 fw-medium">@Model.LanguageName</dd></dl></div><div class="card-footer d-flex gap-2"><form asp-action="DeleteLanguageConfirmed" asp-route-id="@Model.LanguageId" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger">Xác nhận xóa</button></form><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div></div></div></div></div>
