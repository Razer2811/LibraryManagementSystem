@model Publisher
@{ ViewData["Title"] = "Xóa nhà xuất bản"; }
<div class="app-content"><div class="container-fluid"><div class="col-xl-8 col-lg-10"><div class="card border-danger"><div class="card-header bg-danger text-white"><h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Xác nhận xóa nhà xuất bản</h5></div><div class="card-body"><div class="alert alert-warning">Bạn có chắc chắn muốn xóa nhà xuất bản này không?</div><dl class="row mb-0"><dt class="col-sm-3">Tên nhà xuất bản</dt><dd class="col-sm-9 fw-medium">@Model.PublisherName</dd><dt class="col-sm-3">Địa chỉ</dt><dd class="col-sm-9">@(Model.Address ?? "—")</dd><dt class="col-sm-3">Điện thoại</dt><dd class="col-sm-9">@(Model.Phone ?? "—")</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@(Model.Email ?? "—")</dd><dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@(Model.IsActive ? "Hoạt động" : "Ngừng hoạt động")</dd></dl></div><div class="card-footer d-flex gap-2"><form asp-action="DeletePublisherConfirmed" asp-route-id="@Model.PublisherId" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Xác nhận xóa</button></form><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div></div></div></div></div>
