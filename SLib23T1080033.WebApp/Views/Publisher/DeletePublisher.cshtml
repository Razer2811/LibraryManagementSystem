@model Publisher

@{
    ViewData["Title"] = "Xóa nhà xuất bản";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Nhà xuất bản</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Xóa nhà xuất bản</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-8 col-lg-10">
                <div class="card">
                    <div class="card-body">
                        <p class="mb-4">
                            Bạn có chắc chắn muốn xóa nhà xuất bản này không?
                            <span class="text-danger">Thao tác này không thể hoàn tác.</span>
                        </p>

                        <dl class="row mb-0">
                            <dt class="col-sm-3 fw-normal text-secondary">Tên nhà xuất bản</dt>
                            <dd class="col-sm-9 fw-medium">@Model.PublisherName</dd>
                            <dt class="col-sm-3 fw-normal text-secondary">Địa chỉ</dt>
                            <dd class="col-sm-9">@(Model.Address ?? "—")</dd>
                            <dt class="col-sm-3 fw-normal text-secondary">Điện thoại</dt>
                            <dd class="col-sm-9">@(Model.Phone ?? "—")</dd>
                            <dt class="col-sm-3 fw-normal text-secondary">Email</dt>
                            <dd class="col-sm-9">@(Model.Email ?? "—")</dd>
                            <dt class="col-sm-3 fw-normal text-secondary">Trạng thái</dt>
                            <dd class="col-sm-9 mb-0">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis fw-medium">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis fw-medium">Ngừng hoạt động</span>
                                }
                            </dd>
                        </dl>
                    </div>
                    <div class="card-footer d-flex flex-wrap gap-2">
                        <form asp-action="DeletePublisherConfirmed" asp-route-id="@Model.PublisherId" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i>Xác nhận xóa
                            </button>
                        </form>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
