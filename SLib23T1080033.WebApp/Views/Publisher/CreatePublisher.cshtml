@model SLib23T1080033.Models.Entities.Publisher

@{
    ViewData["Title"] = "Thêm nhà xuất bản";
}

<div class="container mt-4">
    <h2 class="mb-4">Thêm nhà xuất bản</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="CreatePublisher" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="PublisherName" class="form-label">
                        Tên nhà xuất bản
                    </label>
                    <input asp-for="PublisherName"
                           class="form-control"
                           placeholder="Nhập tên nhà xuất bản" />
                    <span asp-validation-for="PublisherName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label">
                        Địa chỉ
                    </label>
                    <input asp-for="Address"
                           class="form-control"
                           placeholder="Nhập địa chỉ" />
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label">
                        Điện thoại
                    </label>
                    <input asp-for="Phone"
                           class="form-control"
                           placeholder="Nhập số điện thoại" />
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">
                        Email
                    </label>
                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="Nhập email" />
                </div>

                <div class="mb-3">
                    <label asp-for="Website" class="form-label">
                        Website
                    </label>
                    <input asp-for="Website"
                           type="url"
                           class="form-control"
                           placeholder="https://example.com" />
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive"
                           class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">
                        Đang hoạt động
                    </label>
                </div>

                <button type="submit" class="btn btn-primary">
                    Thêm nhà xuất bản
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Quay lại
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
