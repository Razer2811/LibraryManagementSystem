
@model IEnumerable<SLib23T1080033.Models.Entities.Author>

@{
    ViewBag.Title = "Quản lý tác giả";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">

        <a asp-action="CreateAuthor" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Thêm tác giả
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 70px;">Mã TG</th>
                            <th>Tên tác giả</th>
                            <th>Tiểu sử</th>
                            <th>Ngày sinh</th>
                            <th>Ngày mất</th>
                            <th>Trạng thái</th>
                            <th style="width: 160px;">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var author in Model)
                            {
                                <tr>
                                    <td>@author.AuthorId</td>
                                    <td>@author.AuthorName</td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(author.Biography)
                                                                        ? "Chưa có"
                                                                        : author.Biography)
                            </td>
                            <td>
                                @(author.BirthDate?.ToString("dd/MM/yyyy") ?? "—")
                            </td>
                            <td>
                                @(author.DeathDate?.ToString("dd/MM/yyyy") ?? "—")
                            </td>
                            <td>
                                @if (author.IsActive)
                                        {
                                            <span class="badge bg-success">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Ngừng hoạt động</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="EditAuthor"
                                           asp-route-id="@author.AuthorId"
                                           class="btn btn-warning btn-sm">
                                            Sửa
                                        </a>

                                        <a asp-action="DeleteAuthor"
                                           asp-route-id="@author.AuthorId"
                                           class="btn btn-danger btn-sm">
                                            Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    Chưa có dữ liệu tác giả.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


