        font-weight: 500;
        font-size: .8125rem;
        color: var(--bs-secondary-color);
        white-space: nowrap;
    }

    .author-table td {
        vertical-align: middle;
    }

    .author-table .col-date {
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .author-bio {
        max-width: 360px;
    }
