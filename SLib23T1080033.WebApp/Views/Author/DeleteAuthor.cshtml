@model Author

@{
    ViewData["Title"] = "Xóa tác giả";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-12">
                <ol class="breadcrumb float-sm-end mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Tác giả</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Xóa tác giả</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-8 col-lg-10">
                <div class="card border-danger">
                    <div class="card-header bg-danger text-white">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>Xác nhận xóa tác giả
                        </h5>
                    </div>

                    <div class="card-body">
                        <div class="alert alert-warning" role="alert">
                            Bạn có chắc chắn muốn xóa tác giả này không? Thao tác này không thể hoàn tác.
                        </div>

                        <dl class="row mb-0">
                            <dt class="col-sm-3">Tên tác giả</dt>
                            <dd class="col-sm-9 fw-medium">@Model.AuthorName</dd>

                            <dt class="col-sm-3">Tiểu sử</dt>
                            <dd class="col-sm-9">
                                @(string.IsNullOrWhiteSpace(Model.Biography) ? "Chưa có" : Model.Biography)
                            </dd>

                            <dt class="col-sm-3">Ngày sinh</dt>
                            <dd class="col-sm-9">@(Model.BirthDate?.ToString("dd/MM/yyyy") ?? "—")</dd>

                            <dt class="col-sm-3">Ngày mất</dt>
                            <dd class="col-sm-9">@(Model.DeathDate?.ToString("dd/MM/yyyy") ?? "—")</dd>

                            <dt class="col-sm-3">Trạng thái</dt>
                            <dd class="col-sm-9">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">Ngừng hoạt động</span>
                                }
                            </dd>
                        </dl>
                    </div>

                    <div class="card-footer d-flex flex-wrap gap-2">
                        <form asp-action="DeleteAuthorConfirmed"
                              asp-route-id="@Model.AuthorId"
                              method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i>Xác nhận xóa
                            </button>
                        </form>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
